{
  "name": "delog-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @plurid/delog-server dev",
    "start": "node --env-file-if-exists=.env packages/delog-server/build/cli.mjs serve",
    "test:e2e": "playwright test",
    "test:python": "python3 -m unittest discover -s packages/delog-client/delog-python/tests",
    "test:rust": "cargo test --manifest-path packages/delog-client/delog-rust/Cargo.toml",
    "pack:check": "node scripts/check-packages.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:python && pnpm test:rust && pnpm build && pnpm test:e2e && pnpm pack:check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "@typescript/native": "catalog:",
    "pnpm": "^11.25.0"
  }
}
