{
  "name": "@plurid/delog-server",
  "version": "0.2.0",
  "description": "Self-hosted centralized logging for local clusters",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/plurid/delog"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "node build/cli.mjs serve",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@plurid/delog-contracts": "workspace:*",
    "@plurid/plurid-react": "catalog:",
    "express": "catalog:",
    "graphql": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "styled-components": "catalog:",
    "@plurid/plurid-data": "catalog:",
    "@plurid/plurid-engine": "catalog:",
    "@plurid/plurid-pubsub": "catalog:",
    "@plurid/plurid-themes": "catalog:",
    "@plurid/plurid-functions": "catalog:",
    "@plurid/plurid-icons-react": "catalog:",
    "@plurid/plurid-functions-react": "catalog:",
    "@plurid/plurid-ui-components-react": "catalog:",
    "@plurid/plurid-ui-state-react": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "react-redux": "catalog:",
    "cross-fetch": "catalog:",
    "@plurid/elementql": "catalog:",
    "@plurid/elementql-client-react": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "@typescript/native": "catalog:"
  },
  "bin": {
    "delog-server": "./build/cli.mjs"
  }
}
